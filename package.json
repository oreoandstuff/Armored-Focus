{
  "name": "armored-focus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply armored_focus --local",
    "db:migrate:remote": "wrangler d1 migrations apply armored_focus --remote",
    "deploy": "vite build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260628.1",
    "@sveltejs/adapter-cloudflare": "^5.0.0",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "autoprefixer": "^10.4.20",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "svelte": "^5.2.0",
    "svelte-check": "^4.1.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@lucide/svelte": "^0.544.0"
  }
}
